{
  "name": "@nkardaz/package-template",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "Yalla Nkardaz",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<USER-NAME>/<REPO>.git"
  },
  "homepage": "https://github.com/<USER-NAME>/<REPO>#readme",
  "bugs": {
    "url": "https://github.com/<USER-NAME>/<REPO>/issues"
  },
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "bundleSizeLimit": 102400,
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:js": "node esbuild.config.mjs",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:js && npm run build:types",
    "dev": "esbuild --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm run type-check",
    "knip": "knip",
    "e18e": "npx @e18e/cli analyze",
    "analyze": "npm run knip || npm run e18e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
